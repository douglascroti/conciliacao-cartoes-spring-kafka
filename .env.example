LOCALSTACK_AUTH_TOKEN=coloque-seu-token-aqui

# Opcionais (os valores abaixo já são o padrão no docker-compose.yml)
# POSTGRES_DB=conciliacao
# POSTGRES_USER=conciliacao
# POSTGRES_PASSWORD=conciliacao

# Onde a Lambda guarda a idempotência dos arquivos: postgres (padrão) ou dynamodb (no LocalStack).
# Depois de trocar: docker compose up -d --wait (recria o LocalStack, que republica a Lambda já configurada)
# IDEMPOTENCIA_PROVEDOR=postgres
# IDEMPOTENCIA_TABELA_DYNAMO=arquivo-recebido
