<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>br.estudo.conciliacao</groupId>
        <artifactId>conciliacao-parent</artifactId>
        <version>0.1.0-SNAPSHOT</version>
    </parent>

    <artifactId>conciliacao-batch</artifactId>
    <name>Conciliação :: Batch</name>
    <description>Serviço que consome o evento de arquivo recebido e executa o job Spring Batch de conciliação.</description>

    <dependencies>
        <dependency>
            <groupId>br.estudo.conciliacao</groupId>
            <artifactId>conciliacao-eventos</artifactId>
        </dependency>

        <!-- Spring Batch com JobRepository no Postgres (o starter "batch" puro guarda tudo em memória e não permite restart). -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-batch-jdbc</artifactId>
        </dependency>
        <dependency>
            <groupId>org.postgresql</groupId>
            <artifactId>postgresql</artifactId>
            <scope>runtime</scope>
        </dependency>

        <!-- Consumer do evento de arquivo recebido e, na 3b, publicação dos resultados. -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-kafka</artifactId>
        </dependency>
        <!-- JsonMapper (Jackson 3) para ler o evento, o mesmo que a Lambda usa para escrevê-lo. -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-jackson</artifactId>
        </dependency>

        <!-- Leitura do arquivo do S3 em streaming. -->
        <dependency>
            <groupId>software.amazon.awssdk</groupId>
            <artifactId>s3</artifactId>
            <exclusions>
                <exclusion>
                    <groupId>software.amazon.awssdk</groupId>
                    <artifactId>netty-nio-client</artifactId>
                </exclusion>
            </exclusions>
        </dependency>

        <!-- /actuator/health e métricas; exige um servidor web. -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-webmvc</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-actuator</artifactId>
        </dependency>
        <!-- Formato do Prometheus em /actuator/prometheus (o Micrometer é a fachada; este é o backend). -->
        <dependency>
            <groupId>io.micrometer</groupId>
            <artifactId>micrometer-registry-prometheus</artifactId>
        </dependency>
        <!-- Tracing: Micrometer Tracing com a ponte para OpenTelemetry, exportando spans via OTLP (Grafana Tempo). -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-opentelemetry</artifactId>
        </dependency>

        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-batch-test</artifactId>
            <scope>test</scope>
        </dependency>
        <!-- Testes de integração (*IT): PostgreSQL, Kafka e LocalStack em containers. -->
        <dependency>
            <groupId>br.estudo.conciliacao</groupId>
            <artifactId>conciliacao-teste-suporte</artifactId>
            <scope>test</scope>
        </dependency>
        <!-- Espera por condições assíncronas (o job roda em outra thread) sem sleep fixo. -->
        <dependency>
            <groupId>org.awaitility</groupId>
            <artifactId>awaitility</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <!-- JAR executável (java -jar) e o goal spring-boot:run para rodar no host. -->
            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
            </plugin>
        </plugins>
    </build>
</project>
